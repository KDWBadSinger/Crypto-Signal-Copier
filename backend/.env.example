# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATABASE_PATH=./data/mia_copier.sqlite3
APP_SEED_DEMO_DATA=true

# Telegram user client
# Create these at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=./data/telegram
# Comma-separated numeric chat/channel IDs. Empty means ingest nothing.
TELEGRAM_ALLOWED_CHAT_IDS=

# Bitget API. Use demo for a Demo API Key or live for a regular API Key.
# Live mode is intentionally read-only; this app never submits real-money orders.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_API_ENVIRONMENT=demo
BITGET_BASE_URL=https://api.bitget.com
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_MODE=isolated
BITGET_MARGIN_COIN=USDT
# Only demo mode can submit orders, and remains dry-run until explicitly enabled.
BITGET_ENABLE_DEMO_ORDERS=false
REQUIRE_MANUAL_REVIEW=true
AUTO_DEMO_ORDER_SIZE=0.01
